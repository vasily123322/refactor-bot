# Telegram bot
BOT_TOKEN=123456:replace_me
ADMIN_USER_ID=123456789
ADMIN_USERNAME=

# Telegram userbot / Telethon
API_ID=123456
API_HASH=replace_me
USERBOT_SESSION=

# Optional userbot proxy. Prefer single URL, or use split fields below.
# Examples: socks5://127.0.0.1:1080, socks5://user:pass@host:1080, http://host:8080
# If provider says "https proxy", use https://... here; Telethon/python-socks will use HTTP CONNECT.
USERBOT_PROXY_URL=
USERBOT_PROXY_SCHEME=socks5
USERBOT_PROXY_HOST=
USERBOT_PROXY_PORT=
USERBOT_PROXY_USERNAME=
USERBOT_PROXY_PASSWORD=

# Database / Redis
DB_URL=sqlite+aiosqlite:///./data/bot.db
# Stable encryption key for secrets stored in DB (external bot tokens).
# Generate once, keep outside Git, and do not rotate without re-encrypting stored values.
# Example generator: python -c "import secrets; print(secrets.token_urlsafe(32))"
DB_SECRET_KEY=
REDIS_DSN=

# Logging
LOG_LEVEL=INFO

# SQLAlchemy pool controls
SQLA_NULLPOOL=false
SQLA_STATICPOOL=false

# Scheduler
REPEAT_OVERFLOW_LIMIT=2

# OpenRouter / LLM
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_TEMPERATURE=0.7
OPENROUTER_TOP_P=0.7
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_MAX_RETRIES=3
OPENROUTER_BACKOFF_INITIAL=0.5
OPENROUTER_BACKOFF_MAX=5.0
AI_MODELS_JSON=

# Optional direct providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Speech transcription
WHISPER_MODEL=whisper-1
SPEECH_PROVIDER=openai
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_WHISPER_MODEL=whisper-large-v3

# HTTP fetch / extraction
HTTP_FETCH_TIMEOUT_SECONDS=30
HTTP_FETCH_MAX_RETRIES=2
HTTP_FETCH_BACKOFF_INITIAL=0.4
HTTP_FETCH_BACKOFF_MAX=3.0
HTTP_FETCH_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/119.0 Safari/537.36
CONTENT_EXTRACT_MAX_LEN=8000
