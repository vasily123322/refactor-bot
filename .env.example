# Telegram bot (required)
BOT_TOKEN=123456:replace_me
API_ID=123456
API_HASH=replace_me

# Administration (optional)
ADMIN_USER_ID=
ADMIN_USERNAME=

# Telegram userbot / Telethon (optional)
USERBOT_SESSION=

# Optional userbot proxy. Prefer the single URL form or use the split fields below.
# Examples: socks5://127.0.0.1:1080, socks5://user:pass@host:1080, http://host:8080
USERBOT_PROXY_URL=
USERBOT_PROXY_SCHEME=
USERBOT_PROXY_HOST=
USERBOT_PROXY_PORT=
USERBOT_PROXY_USERNAME=
USERBOT_PROXY_PASSWORD=

# Database / Redis
DB_URL=sqlite+aiosqlite:///./data/bot.db
REDIS_DSN=
# Stable key for encrypted DB secrets such as external-bot tokens.
# New encrypted writes require at least 32 characters. Preserve the same key when
# restoring a database that already contains enc:v1 encrypted values.
DB_SECRET_KEY=
# SQLAlchemy pool controls. SQLite already uses NullPool by default unless StaticPool is enabled.
SQLA_NULLPOOL=false
SQLA_STATICPOOL=false

# Telegram Studio Mini App API
# Disabled by default. Invalid explicit bool/int values fail closed.
STUDIO_ENABLED=false
STUDIO_HOST=127.0.0.1
STUDIO_PORT=8080
STUDIO_PUBLIC_URL=
# Signed Telegram Mini App initData replay window, seconds (60..604800).
STUDIO_INIT_DATA_MAX_AGE_SECONDS=86400
# Comma-separated origins for a separately hosted frontend; empty means same-origin only.
STUDIO_CORS_ORIGINS=

# Logging
LOG_LEVEL=INFO
# Repository-managed logs/bot.log sink. Disable when stdout/stderr persistence is external.
LOG_FILE_ENABLED=true
# Loguru retention expression; the file sink rotates daily and compresses rotated logs.
LOG_FILE_RETENTION=14 days

# Repeat scheduler
REPEAT_OVERFLOW_LIMIT=2

# Canonical repeat migration/cutover controls.
# All are default-off. Each authoritative planning flag requires its matching shadow
# observation flag before runtime validation permits the cutover.
CANONICAL_REPEAT_SHADOW_PLANNING_ENABLED=false
CANONICAL_REPEAT_SUCCESSFUL_PLANNING_ENABLED=false
CANONICAL_REPEAT_OVERDUE_RECOVERY_SHADOW_ENABLED=false
CANONICAL_REPEAT_OVERDUE_RECOVERY_PLANNING_ENABLED=false
CANONICAL_REPEAT_BOOT_RECOVERY_SHADOW_ENABLED=false
CANONICAL_REPEAT_BOOT_RECOVERY_PLANNING_ENABLED=false

# Expired canonical publication-delivery lease recovery.
# Default-off and fail-closed; it marks ambiguous expired deliveries unknown and never resends.
CANONICAL_PUBLICATION_DELIVERY_RECOVERY_WORKER_ENABLED=false
CANONICAL_PUBLICATION_DELIVERY_RECOVERY_WORKER_INTERVAL_SECONDS=60
CANONICAL_PUBLICATION_DELIVERY_RECOVERY_WORKER_BATCH_SIZE=100

# Canonical primary publication delivery.
# Default-off. Enabling it requires delivery recovery above to be enabled too.
CANONICAL_PUBLICATION_DELIVERY_WORKER_ENABLED=false
CANONICAL_PUBLICATION_DELIVERY_WORKER_INTERVAL_SECONDS=5
CANONICAL_PUBLICATION_DELIVERY_WORKER_BATCH_SIZE=25
CANONICAL_PUBLICATION_DELIVERY_WORKER_SCAN_LIMIT=500
CANONICAL_PUBLICATION_DELIVERY_WORKER_LEASE_TTL_SECONDS=180
CANONICAL_PUBLICATION_DELIVERY_WORKER_HEARTBEAT_INTERVAL_SECONDS=30

# Canonical time-based publication autodelete.
# Destructive worker; explicitly opt in.
PUBLICATION_AUTODELETE_WORKER_ENABLED=false
PUBLICATION_AUTODELETE_WORKER_INTERVAL_SECONDS=60
PUBLICATION_AUTODELETE_WORKER_BATCH_SIZE=25
PUBLICATION_AUTODELETE_WORKER_LEASE_TTL_SECONDS=180

# Canonical views-based publication autodelete.
# Explicit opt-in and requires the userbot to start successfully because views use MTProto.
PUBLICATION_AUTODELETE_VIEWS_WORKER_ENABLED=false
PUBLICATION_AUTODELETE_VIEWS_WORKER_INTERVAL_SECONDS=60
PUBLICATION_AUTODELETE_VIEWS_WORKER_BATCH_SIZE=25
PUBLICATION_AUTODELETE_VIEWS_WORKER_LEASE_TTL_SECONDS=180
PUBLICATION_AUTODELETE_VIEWS_WORKER_NEXT_CHECK_SECONDS=60
PUBLICATION_AUTODELETE_VIEWS_WORKER_INELIGIBLE_BACKOFF_SECONDS=300

# Deterministic local Inbox enrichment (never uses AI providers).
LOCAL_ENRICHMENT_WORKER_ENABLED=false
LOCAL_ENRICHMENT_WORKER_INTERVAL_SECONDS=15.0
LOCAL_ENRICHMENT_WORKER_BATCH_SIZE=20
LOCAL_ENRICHMENT_WORKER_CANDIDATE_TIMEOUT_SECONDS=10.0

# OpenRouter / LLM
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_TEMPERATURE=0.7
OPENROUTER_TOP_P=0.7
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_MAX_RETRIES=3
OPENROUTER_BACKOFF_INITIAL=0.5
OPENROUTER_BACKOFF_MAX=5.0
AI_MODELS_JSON=

# Optional direct providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Speech transcription
WHISPER_MODEL=whisper-1
SPEECH_PROVIDER=openai
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_WHISPER_MODEL=whisper-large-v3

# HTTP fetch / extraction
HTTP_FETCH_TIMEOUT_SECONDS=30
HTTP_FETCH_MAX_RETRIES=2
HTTP_FETCH_BACKOFF_INITIAL=0.4
HTTP_FETCH_BACKOFF_MAX=3.0
HTTP_FETCH_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/119.0 Safari/537.36
CONTENT_EXTRACT_MAX_LEN=8000
